  "tokenRequest": {
    "method": "POST",
    "path": "/agents/token",
    "contentType": "application/x-www-form-urlencoded",
    "form": {
      "grant_type": "client_credentials",
      "client_assertion_type": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"
    },
    "assertion": {
      "header": [
        "alg",
        "kid"
      ],
      "claims": {
        "iss": "{id}",
        "sub": "{id}",
        "aud": "{baseUrl}/agents/token",
        "maxLifetimeSeconds": 300
      }
    },
    "dpop": {
      "header": {
        "typ": "dpop+jwt"
      },
      "claims": [
        "htm",
        "htu",
        "iat",
        "jti"
      ],
      "onCalls": [
        "ath"
      ]
    }
  },
  "calls": [
    {
      "name": "create",
      "args": {
        "name": "Invoice bot",
        "allowedTypes": [
          "SEND_MONEY"
        ],
        "ownerEmail": "owner@example.com",
        "platform": "openai-agents",
        "reviewInDays": 30
      },
      "method": "POST",
      "path": "/agents",
      "body": {
        "name": "Invoice bot",
        "allowedTypes": [
          "SEND_MONEY"
        ],
        "ownerEmail": "owner@example.com",
        "platform": "openai-agents",
        "reviewInDays": 30,
        "publicKey": "{publicKey}"
      }
    },
    {
