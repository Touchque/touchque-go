        "limit": 50
      },
      "method": "GET",
      "path": "/agents/events",
      "query": "after=cursor-1&limit=50"
    },
    {
      "name": "listBlocks",
      "args": {},
      "method": "GET",
      "path": "/agents/{id}/blocks"
    },
    {
      "name": "killSwitch",
