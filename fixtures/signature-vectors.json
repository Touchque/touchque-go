{
  "secret": "whsec_fixture_secret_0123456789abcdef",
  "note": "expected_signature = HMAC-SHA256(secret, `${METHOD}:${signed_path}:${timestamp}:${nonce}:${sha256hex(body)}`)",
  "vectors": [
    {
      "description": "POST with a JSON body",
      "method": "POST",
      "signed_path": "/login/request",
      "body": "{\"externalUsername\":\"user@company.com\",\"type\":\"LOGIN\"}",
      "timestamp": "1788000000000",
      "nonce": "0123456789abcdef0123456789abcdef",
      "expected_signature": "189f70d50b408e47612c1fe0873b5be97e69f9c2e37894abb1a48d36a2d40bbb"
    },
    {
      "description": "POST with an empty object body",
      "method": "POST",
      "signed_path": "/auth/generate-secret",
      "body": "{}",
      "timestamp": "1788000000000",
      "nonce": "0123456789abcdef0123456789abcdef",
      "expected_signature": "bf51f04352576a9a632da2c1543b7ac59342f22e411ced9d2c0b6b1d2d155704"
    },
    {
      "description": "GET, no query, empty body",
      "method": "GET",
      "signed_path": "/login/status/req_00000000-0000-0000-0000-000000000000",
      "body": "",
      "timestamp": "1788000000000",
      "nonce": "0123456789abcdef0123456789abcdef",
      "expected_signature": "3d6454284c7a23c3f80d2a44d7904f8e3f1482ac567abaacd5d3da6569cd45b0"
    },
    {
      "description": "GET with one query param folded into the signed path",
      "method": "GET",
      "signed_path": "/webauthn/credentials?externalUsername=a%2Bb%40company.com",
      "body": "",
      "base_path": "/webauthn/credentials",
      "query": {
        "externalUsername": "a+b@company.com"
      },
      "timestamp": "1788000000000",
      "nonce": "0123456789abcdef0123456789abcdef",
      "expected_signature": "381bfa4d89ed239a9c53ad90a7a5f613d9d0d9b833d24aa8c46233887fb6cf7f"
    },
    {
      "description": "GET with two query params — MUST be sorted by key in the signed path",
      "method": "GET",
      "signed_path": "/things?a=1&b=2",
      "body": "",
      "base_path": "/things",
      "query": {
        "b": "2",
        "a": "1"
      },
      "timestamp": "1788000000000",
      "nonce": "0123456789abcdef0123456789abcdef",
      "expected_signature": "413d4625fb1d4dc5e26a1d69ba37669eda11606445978179aa6616fcc38be044"
    },
    {
      "description": "DELETE with a URL-encoded path segment, empty body",
      "method": "DELETE",
      "signed_path": "/webauthn/credentials/cred%2F1%202",
      "body": "",
      "timestamp": "1788000000000",
      "nonce": "0123456789abcdef0123456789abcdef",
      "expected_signature": "f6f7f62c4b582cfbbfc4bd419c2a5e399dd6974300fa3c92126eb6a27100be20"
    }
  ]
}
